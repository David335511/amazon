# ──────────────────────────────────────────────────────────────
# Production environment template (Render / Neon / Upstash / Grafana)
#
# Copy this file to .env.production locally, OR paste the values into
# the service's env vars in the Render dashboard. Keep secrets out of git.
# ──────────────────────────────────────────────────────────────

# App
APP_ENV=production
APP_NAME=Amazon
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-long-random-string

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# ── Postgres (Neon) ──────────────────────────────────────────
# Neon gives a connection string like:
#   postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# For SQLAlchemy async, prefix the driver as shown (keep the rest as-is).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ── Redis (Upstash) ──────────────────────────────────────────
# Use the "rediss://" (TLS) TCP connection string Upstash provides.
# redis-py + hiredis supports this directly.
REDIS_URL=rediss://default:TOKEN@host:6379/0

# ── OpenTelemetry (Grafana Cloud) ────────────────────────────
# Endpoint: Grafana Cloud > Your Stack > Details > "OTLP" > https URL,
# e.g. https://otlp-gateway-prod-<region>.grafana.net/otlp
OTEL_SERVICE_NAME=amazon
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
# Instance ID + API token, comma-separated key=value pairs.
OTEL_EXPORTER_OTLP_HEADERS=X-Pt-Instance-Id=INSTANCE_ID,Authorization=Bearer API_TOKEN
