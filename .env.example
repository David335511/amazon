# ──────────────────────────────────────────────────────────────
# Amazon AI Commerce Platform — Environment Variables
# Copy to .env and fill in secrets
# ──────────────────────────────────────────────────────────────

# Application
APP_NAME=Amazon
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://amazon:amazon@localhost:5432/amazon
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry
OTEL_SERVICE_NAME=amazon
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_WORKERS=1
