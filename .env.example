# ──────────────────────────────────────────────────────────────
# Amazon AI Commerce Platform — Environment Variables
# Copy to .env and fill in secrets
# ──────────────────────────────────────────────────────────────

# Application
APP_NAME=Amazon
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=postgresql+asyncpg://amazon:amazon@localhost:5432/amazon
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry
OTEL_SERVICE_NAME=amazon
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
SERVER_WORKERS=1

# Retailer product data (Walmart / Home Depot via SerpApi free tier)
# Sign up at https://serpapi.com for a free API key (250 searches/month).
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_REQUESTS_PER_MINUTE=10
SERPAPI_CACHE_TTL=3600
# Total SerpApi searches allowed per calendar month. The refresh scheduler
# paces lookups (daily_allowance = remaining / days_left) so the month lasts.
SERPAPI_MONTHLY_BUDGET=250
# Products the background scheduler keeps fresh, as '<provider>:<product_id>'
# comma-separated. Providers: walmart, home_depot. Empty = scheduler stays idle.
SERPAPI_MONITOR_PRODUCTS=walmart:10291024
# Seconds between refresh cycles (default 6 hours). Budget pacing still applies.
SERPAPI_SCHEDULER_INTERVAL=21600
